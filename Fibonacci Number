class Solution(object):
    def fib(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n == 0:
            return 0
        if n == 1:
            return 1
        
        prev = 0
        cur = 1

        for i in range(1, n):
            prev, cur = cur, prev + cur

        return cur
